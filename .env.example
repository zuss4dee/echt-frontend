# Copy to `.env.local` for the Echt app (sign-in, onboarding, analyze).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase Auth (confirmation & recovery emails) ---
# Full checklist: frontend/docs/SUPABASE_AUTH.md
#
# Dashboard → Auth → URL Configuration
#   Site URL: primary app origin (e.g. https://useecht.com)
#   Redirect URLs (allow list), one per host:
#     https://useecht.com/auth/callback
#     https://www.useecht.com/auth/callback
#     http://localhost:3000/auth/callback
#     https://useecht.com/auth/recovery-callback
#     https://www.useecht.com/auth/recovery-callback
#     http://localhost:3000/auth/recovery-callback
#
# Dashboard → Auth → Providers → Email
#   "Confirm email" ON  → signup sends mail; no session until link opened (app shows check-email UI)
#   "Confirm email" OFF → signup returns session immediately (redirect to onboarding)
#
# Dashboard → Auth → SMTP (required for signup/reset delivery)
#   RESEND_API_KEY below is NOT used by Supabase Auth until SMTP is configured in the dashboard.
#   Quick setup: ./scripts/configure-resend-smtp.sh (needs SUPABASE_ACCESS_TOKEN)
# B2B contact form (Clearance section) — Resend
# RESEND_API_KEY=re_...
# CONTACT_INBOX_EMAIL=hello@useecht.com
# CONTACT_FROM_EMAIL=Echt <hello@useecht.com>

# Polar checkout verification runs on the FastAPI backend (POLAR_SECRET_KEY in backend/.env).
# NEXT_PUBLIC_API_URL must point at that backend for /onboarding registration.
# RESEND_API_KEY=re_...
# SUPABASE_ACCESS_TOKEN=sbp_...   # optional; for configure-resend-smtp.sh only
#
# Optional: canonical app URL (e.g. Polar checkout return links later)
# NEXT_PUBLIC_APP_URL=https://www.useecht.com
